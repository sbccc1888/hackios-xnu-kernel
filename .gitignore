# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones, files of iOS and the hackios-xnu-userland checkout (common/setup.sh), none of which belongs
# in this repository. Nothing is tracked unless it is named here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml
!/.github/workflows/mesa.yml
!/common/
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/xnu/
!/xnu-deps/
!/uefi/
!/prebuilt/
!/wifi/

__pycache__/
*~
*.orig
*.rej

# hackios-xnu-userland's files share this working tree (common/setup.sh)
/docs/air.md
/docs/air-report.md
/prebuilt/userland/
/tools/apfs/
/tools/air/
/tools/mesa/
/tools/metal/
/tools/mk-mesa.sh
/tools/mk-jb.sh
/tools/jb-preinstall.py
/tools/font_trim.py
/tools/metallib.py

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/identity.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize
!/tools/mk-mesa.sh
!/tools/mesa/
/tools/mesa/*
!/tools/mesa/redwood-drm/
/tools/mesa/redwood-drm/*
!/tools/mesa/redwood-drm/redwood_drm.c
!/tools/mesa/redwood-drm/xf86drm.h
!/tools/mesa/air-frontend.patch
!/tools/mesa/air-ir3.patch
!/tools/mesa/air-metal.patch
!/tools/mesa/freedreno-darwin.patch
!/tools/mesa/ir3-round-default.patch
!/tools/mesa/ir3-shift-split.patch
!/tools/mesa/ir3-ssbo-subdword.patch
!/tools/mesa/osmesa-es-profile.patch
!/tools/mesa/air/
/tools/mesa/air/*
!/tools/mesa/air/air2nir.c
!/tools/mesa/air/air_bitcode.c
!/tools/mesa/air/air_bitcode.h
!/tools/mesa/air/air_intrinsics.c
!/tools/mesa/air/air_layout.c
